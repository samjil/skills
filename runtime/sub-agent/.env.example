# sub-agent 설정 예시. 이 파일을 .env 로 복사해 쓴다(.env 는 커밋하지 않는다).
# opencode 인증은 `opencode auth login` 으로 한 번 해 두는 것이 기본이다. 아래 키는 환경변수로 읽는 경우를 위한 것.
OPENROUTER_API_KEY=
# opencode 가 쓸 모델(`opencode models openrouter` 로 지금 실제로 있는 이름을 확인해서 적는다)
SUB_AGENT_OPENCODE_MODEL=openrouter/qwen/qwen3-coder:free
# agy 모델 순서. 쿼터가 차면 다음 모델로 넘어간다(`agy models` 로 확인)
SUB_AGENT_AGY_MODELS=gemini-3.8-flash-high,gemini-3.7-flash-high
# 엔진당 제한 시간(초)
SUB_AGENT_TIMEOUT=300
# agy 가 읽기 권한을 물어 멈추면 1 로(주의: 쓰기 권한 확인도 건너뛴다)
SUB_AGENT_AGY_SKIP_PERMISSIONS=0
