#!/bin/sh
# pre-push: 푸시하기 전에 전체 시험(tests/run-all.ps1)을 돌리고, 하나라도 실패하면 푸시를 막는다.
#
# 켜는 법(저장소를 새로 받았다면 한 번만):  git config core.hooksPath .githooks
#
# 걸리는 시간: 전부 약 9분. 환경변수로 조절한다.
#   PREPUSH_FAST=1            오래 걸리는 시험(e2e 등)을 뺀다(run-all.ps1 -Fast)
#   PREPUSH_ARGS="-Only a,b"  run-all.ps1 에 넘길 인자(이름에 이 글자가 든 시험만 등)
#   SKIP_PREPUSH_TESTS=1      시험을 건너뛴다(급할 때). git push --no-verify 도 같은 효과
# 주의: 시험은 "푸시할 커밋"이 아니라 지금 작업 폴더의 파일로 돈다. 커밋하지 않은 변경이 있으면 그것도 포함된다.
# 이 파일은 줄바꿈이 LF 여야 한다(.gitattributes 에서 고정). CRLF 이면 sh 가 "bad interpreter" 로 실패한다.

zero=0000000000000000000000000000000000000000
needs_run=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # 브랜치·태그를 지우는 푸시(local sha 가 전부 0)는 올라가는 코드가 없으니 시험하지 않는다
    if [ "$local_sha" != "$zero" ]; then needs_run=1; fi
done
if [ "$needs_run" = "0" ]; then exit 0; fi

if [ "$SKIP_PREPUSH_TESTS" = "1" ]; then
    echo "[pre-push] SKIP_PREPUSH_TESTS=1 이라 시험을 건너뜁니다."
    exit 0
fi

root=$(git rev-parse --show-toplevel)
runner="$root/tests/run-all.ps1"
if command -v cygpath >/dev/null 2>&1; then runner=$(cygpath -w "$runner"); fi

args="$PREPUSH_ARGS"
if [ "$PREPUSH_FAST" = "1" ]; then args="-Fast $args"; fi

echo "[pre-push] 푸시 전에 시험을 돌립니다 (run-all.ps1 $args) ..."
# shellcheck disable=SC2086
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$runner" $args
status=$?
if [ "$status" -ne 0 ]; then
    echo "[pre-push] 시험이 실패해서 푸시를 막았습니다."
    echo "[pre-push] 급하면: SKIP_PREPUSH_TESTS=1 git push   (또는 git push --no-verify)"
    exit 1
fi
echo "[pre-push] 시험 통과 - 푸시를 계속합니다."
exit 0
