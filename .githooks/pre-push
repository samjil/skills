#!/bin/sh
# pre-push: 푸시 전에 시험(tests/run-all.ps1)을 돌려 보고, 실패하면 푸시를 막는 훅. 기본은 시험을 돌리지 않는다(시험이 몇 분씩 걸려 푸시가 실패하는 일이 있었다).
# 푸시 전에 시험이 필요할 때만 명시한다:
#   PREPUSH_TESTS=1 git push   빠른 실행(run-all.ps1 -Fast)으로 시험한 뒤 푸시
#   PREPUSH_FULL=1 git push    전체 시험(병렬로 약 3분)
#   PREPUSH_ARGS="-Only a,b"   run-all.ps1 에 넘길 인자를 더한다(이름에 이 글자가 든 시험만 등)
# GitHub Desktop 처럼 환경변수를 줄 수 없는 도구로 푸시할 때는 시험 없이 푸시된다. 필요하면 tests/run-all.ps1 을 미리 돌린다.
#
# 켜는 법(저장소를 새로 받았다면 한 번만):  powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-dev.ps1   (= git config core.hooksPath .githooks + 환경 점검)
# 주의: 시험은 "푸시할 커밋"이 아니라 지금 작업 폴더의 파일로 돈다. 커밋하지 않은 변경이 있으면 그것도 포함된다.
# 이 파일은 줄바꿈이 LF 여야 한다(.gitattributes 에서 고정). CRLF 이면 sh 가 "bad interpreter" 로 실패한다.

zero=0000000000000000000000000000000000000000
needs_run=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # 브랜치·태그를 지우는 푸시(local sha 가 전부 0)는 올라가는 코드가 없으니 시험하지 않는다
    if [ "$local_sha" != "$zero" ]; then needs_run=1; fi
done
if [ "$needs_run" = "0" ]; then exit 0; fi

# 시험을 명시하지 않았으면 그대로 푸시한다(SKIP_PREPUSH_TESTS=1 이 있으면 명시했어도 건너뛴다)
if [ "$SKIP_PREPUSH_TESTS" = "1" ] || { [ "$PREPUSH_TESTS" != "1" ] && [ "$PREPUSH_FULL" != "1" ]; }; then
    exit 0
fi

# Windows 가 아닌 환경 등 powershell.exe 가 없으면 시험을 돌릴 수 없으니 푸시를 막지 않고 알리기만 한다
if ! command -v powershell.exe >/dev/null 2>&1; then
    echo "[pre-push] powershell.exe 가 없어 시험을 건너뜁니다."
    exit 0
fi

root=$(git rev-parse --show-toplevel)
runner="$root/tests/run-all.ps1"
if command -v cygpath >/dev/null 2>&1; then runner=$(cygpath -w "$runner"); fi

args="$PREPUSH_ARGS"
if [ "$PREPUSH_FULL" != "1" ]; then args="-Fast $args"; fi

echo "[pre-push] 푸시 전에 시험을 돌립니다 (run-all.ps1 $args) ..."
# shellcheck disable=SC2086
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$runner" $args
status=$?
if [ "$status" -ne 0 ]; then
    echo "[pre-push] 시험이 실패해서 푸시를 막았습니다."
    echo "[pre-push] 급하면: SKIP_PREPUSH_TESTS=1 git push   (또는 git push --no-verify)"
    exit 1
fi
echo "[pre-push] 시험 통과 - 푸시를 계속합니다."
exit 0
